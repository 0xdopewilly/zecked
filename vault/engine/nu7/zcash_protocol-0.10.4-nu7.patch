+    // ---- ZECKED NU7 backport tests: the values upstream set in 0.11.0-pre.0 ----
+
+    #[test]
+    fn nu_ordering_testnet() {
+        use super::TEST_NETWORK;
+        for i in 1..UPGRADES_IN_ORDER.len() {
+            let nu_a = UPGRADES_IN_ORDER[i - 1];
+            let nu_b = UPGRADES_IN_ORDER[i];
+            match (
+                TEST_NETWORK.activation_height(nu_a),
+                TEST_NETWORK.activation_height(nu_b),
+            ) {
+                (Some(a), Some(b)) if a < b => (),
+                (Some(_), None) => (),
+                (None, None) => (),
+                _ => panic!(
+                    "{} should not be before {} in UPGRADES_IN_ORDER (testnet)",
+                    nu_a, nu_b
+                ),
+            }
+        }
+    }
+
+    #[cfg(zcash_unstable = "nu7")]
+    #[test]
+    fn nu7_branch_id_is_zip259_value() {
+        const NU7_BRANCH_ID: u32 = 0x7719_0ad9;
+        assert_eq!(u32::from(BranchId::Nu7), NU7_BRANCH_ID);
+        assert_eq!(BranchId::try_from(NU7_BRANCH_ID), Ok(BranchId::Nu7));
+        // The old placeholder must no longer decode to anything.
+        assert!(BranchId::try_from(0xffff_ffff).is_err());
+        assert_eq!(NetworkUpgrade::Nu7.branch_id(), BranchId::Nu7);
+        assert_eq!(BranchId::Nu7.network_upgrade(), Some(NetworkUpgrade::Nu7));
+        // NU6.3 is untouched.
+        assert_eq!(u32::from(BranchId::Nu6_3), 0x37a5_165b);
+    }
+
+    #[cfg(zcash_unstable = "nu7")]
+    #[test]
+    fn nu7_activates_on_testnet_only() {
+        use super::TEST_NETWORK;
+        const TESTNET_NU7_ACTIVATION: BlockHeight = BlockHeight(4_465_026);
+
+        assert_eq!(MAIN_NETWORK.activation_height(NetworkUpgrade::Nu7), None);
+        assert_eq!(
+            TEST_NETWORK.activation_height(NetworkUpgrade::Nu7),
+            Some(TESTNET_NU7_ACTIVATION)
+        );
+
+        // Mainnet keeps signing with the NU6.3 branch id at any height.
+        assert_eq!(
+            BranchId::for_height(&MAIN_NETWORK, BlockHeight(5_000_000)),
+            BranchId::Nu6_3
+        );
+        assert_eq!(
+            BranchId::for_height(&MAIN_NETWORK, BlockHeight(u32::MAX)),
+            BranchId::Nu6_3
+        );
+
+        // Testnet: NU6.3 up to the block before activation, NU7 from activation on.
+        assert_eq!(
+            BranchId::for_height(&TEST_NETWORK, BlockHeight(4_465_025)),
+            BranchId::Nu6_3
+        );
+        assert_eq!(
+            u32::from(BranchId::for_height(&TEST_NETWORK, BlockHeight(4_465_025))),
+            0x37a5_165b
+        );
+        assert_eq!(
+            BranchId::for_height(&TEST_NETWORK, TESTNET_NU7_ACTIVATION),
+            BranchId::Nu7
+        );
+        assert_eq!(
+            u32::from(BranchId::for_height(&TEST_NETWORK, TESTNET_NU7_ACTIVATION)),
+            0x7719_0ad9
+        );
+        assert!(TEST_NETWORK.is_nu_active(NetworkUpgrade::Nu7, TESTNET_NU7_ACTIVATION));
+        assert!(!TEST_NETWORK.is_nu_active(NetworkUpgrade::Nu7, BlockHeight(4_465_025)));
+
+        // Epoch bounds: the testnet NU6.3 epoch now ends at NU7 activation; mainnet's does not.
+        assert_eq!(
+            BranchId::Nu6_3.height_bounds(&TEST_NETWORK),
+            Some((BlockHeight(4_134_000), Some(TESTNET_NU7_ACTIVATION)))
+        );
+        assert_eq!(
+            BranchId::Nu7.height_bounds(&TEST_NETWORK),
+            Some((TESTNET_NU7_ACTIVATION, None))
+        );
+        assert_eq!(
+            BranchId::Nu6_3.height_bounds(&MAIN_NETWORK),
+            Some((BlockHeight(3_428_143), None))
+        );
+        assert_eq!(BranchId::Nu7.height_bounds(&MAIN_NETWORK), None);
+    }
 }
